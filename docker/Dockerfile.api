FROM rust:1-bookworm AS build
WORKDIR /app
ENV CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse
ENV CARGO_HTTP_TIMEOUT=600
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN cargo build -p dup-finder-cli --release

FROM debian:bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/target/release/dup-finder /usr/local/bin/dup-finder
WORKDIR /data
EXPOSE 7420
ENV DUP_FINDER_ALLOW_NON_LOOPBACK=1
ENV DUP_FINDER_TOKEN=dev-token-change-me
CMD ["dup-finder", "serve", "--host", "0.0.0.0", "--port", "7420", "--token", "dev-token-change-me"]
